# Pollinations API Key - Get yours at https://enter.pollinations.ai
POLLINATIONS_KEY=your_api_key_here

# Backward-compatible aliases also supported:
# POLLINATION_API_KEY=your_api_key_here
# POLLIX_API_KEY=your_api_key_here

# Default model (openai, openai-fast, deepseek, gemini, claude)
POLLIX_DEFAULT_MODEL=openai

# Default context mode (minimal, auto, full, files)
POLLIX_CONTEXT_MODE=auto

# Default temperature (0.0 - 1.0)
POLLIX_TEMPERATURE=0.7

# Default max tokens
POLLIX_MAX_TOKENS=4096

# Theme for output (dark, light)
POLLIX_THEME=dark

# Enable auto-backup before file edits (true/false)
POLLIX_AUTO_BACKUP=true

# Maximum file size to read (bytes)
POLLIX_MAX_FILE_SIZE=100000
